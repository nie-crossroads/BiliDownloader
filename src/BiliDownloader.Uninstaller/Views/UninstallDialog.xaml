<UserControl x:Class="BiliDownloader.Uninstaller.Views.UninstallDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- 圆角由窗口的 DWM 处理；不再自绘投影，避免被窗口边界裁出脏边。 -->
  <Border Background="{DynamicResource Surface}" Width="432">
    <StackPanel>
      <DockPanel x:Name="HeaderDock" LastChildFill="False" Margin="18,18,18,0" VerticalAlignment="Center"
                 Background="Transparent" Cursor="SizeAll">
        <Border Width="28" Height="28" CornerRadius="99" Background="{DynamicResource DangerSoft}"
                Margin="0,0,10,0">
        <Canvas Width="14" Height="14" VerticalAlignment="Center" HorizontalAlignment="Center">
          <Path Data="M8 2.4 L13.6 12.4 L2.4 12.4 Z" Stroke="{DynamicResource Danger}"
                StrokeThickness="1.3" StrokeLineJoin="Round" Fill="Transparent"/>
          <Path Data="M8 6.4 L8 9.4" Stroke="{DynamicResource Danger}" StrokeThickness="1.4"
                StrokeEndLineCap="Round"/>
          <Ellipse Canvas.Left="7.2" Canvas.Top="10.2" Width="1.6" Height="1.6"
                   Fill="{DynamicResource Danger}"/>
        </Canvas>
        </Border>
        <TextBlock Text="卸载 BiliDownloader" FontSize="13.5" FontWeight="SemiBold"
                   Foreground="{DynamicResource Fg}" VerticalAlignment="Center"/>
      </DockPanel>

      <StackPanel Margin="18,12,18,16">
        <TextBlock Style="{DynamicResource DlgBody}"
                   Text="将从这台电脑移除程序文件、桌面快捷方式和卸载项。"/>
        <CheckBox Style="{DynamicResource ChkBox}" Margin="0,10,0,0"
                  Content="同时删除登录凭证、设置与日志" IsChecked="{Binding DeleteUserData}"/>
        <Border Style="{DynamicResource WarnLine}">
          <TextBlock Style="{DynamicResource DlgBody}">
            已下载的视频文件不会被删除。<LineBreak/>
            默认保存目录：<Run FontFamily="Consolas" Text="{Binding DefaultSaveDir, Mode=OneWay}"/>
          </TextBlock>
        </Border>
      </StackPanel>

      <Border Height="54" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"
              Background="{DynamicResource Surface}">
        <DockPanel LastChildFill="False" VerticalAlignment="Center" Margin="18,0">
          <Button DockPanel.Dock="Left" Style="{DynamicResource BtnGhost}" Content="取消"
                  Command="{Binding CancelCommand}"/>
          <Button DockPanel.Dock="Right" Style="{DynamicResource BtnDanger}" Content="卸载"
                  Command="{Binding UninstallCommand}" Margin="10,0,0,0"/>
        </DockPanel>
      </Border>
    </StackPanel>
  </Border>
</UserControl>
