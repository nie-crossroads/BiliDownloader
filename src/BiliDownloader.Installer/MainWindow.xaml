<Window x:Class="BiliDownloader.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BiliDownloader.Installer.Views"
        xmlns:sh="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        WindowStyle="None" AllowsTransparency="False"
        Background="{DynamicResource Surface}"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        SnapsToDevicePixels="True" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Title="BiliDownloader 安装向导"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, Microsoft YaHei, system-ui">
  <!-- 不用 AllowsTransparency：那会强制分层窗口渲染并禁用 ClearType，文字发虚。
       改用 WindowChrome 去掉系统标题栏，圆角由 DWM 绘制（见 WindowChromeHelper）。 -->
  <sh:WindowChrome.WindowChrome>
    <sh:WindowChrome CaptionHeight="0" ResizeBorderThickness="0"
                     GlassFrameThickness="0" CornerRadius="0"
                     UseAeroCaptionButtons="False"/>
  </sh:WindowChrome.WindowChrome>

  <local:WizardCard/>
</Window>
