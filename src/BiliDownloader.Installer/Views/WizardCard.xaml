<UserControl x:Class="BiliDownloader.Installer.Views.WizardCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BiliDownloader.Installer.Views"
             xmlns:conv="clr-namespace:BiliDownloader.Installer.Infra"
             Width="660">
  <UserControl.Resources>
    <conv:StepToVisibilityConverter x:Key="StepVis"/>
  </UserControl.Resources>

  <!-- 圆角由窗口的 DWM 处理；这里不再自绘圆角和投影，否则会被窗口边界裁出脏边。 -->
  <Border Background="{DynamicResource Surface}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- 头部 -->
      <Border x:Name="HeaderBorder" Grid.Row="0" Height="54"
              BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="18,0"
              MouseLeftButtonDown="OnHeaderDrag" Background="Transparent">
        <DockPanel LastChildFill="False" VerticalAlignment="Center">
          <!-- 与任务栏 / 资源管理器共用同一份 app.ico，保证两处图标完全一致 -->
          <Image DockPanel.Dock="Left" Width="26" Height="26" VerticalAlignment="Center"
                 Source="/Resources/app.ico"
                 RenderOptions.BitmapScalingMode="HighQuality"/>
          <TextBlock DockPanel.Dock="Left" Text="BiliDownloader" Margin="11,0,0,0"
                     FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Fg}"
                     VerticalAlignment="Center"/>
          <TextBlock DockPanel.Dock="Left" Text="1.0.0 · Windows 64 位" Margin="6,0,0,0"
                     FontSize="11" Foreground="{DynamicResource Fg3}" VerticalAlignment="Center"/>
          <TextBlock DockPanel.Dock="Right" Text="{Binding HeaderRightText}"
                     FontSize="11" Foreground="{DynamicResource Fg3}" VerticalAlignment="Center"/>
        </DockPanel>
      </Border>

      <!-- 步骤内容（按 Step 切换可见性，每步自带页脚） -->
      <Grid Grid.Row="1">
        <local:StepWelcome x:Name="StepWelcomeEl" Visibility="{Binding Step, Converter={StaticResource StepVis}, ConverterParameter=Welcome}"/>
        <local:StepInstalling x:Name="StepInstallingEl" Visibility="{Binding Step, Converter={StaticResource StepVis}, ConverterParameter=Installing}"/>
        <local:StepDone x:Name="StepDoneEl" Visibility="{Binding Step, Converter={StaticResource StepVis}, ConverterParameter=Done}"/>
      </Grid>
    </Grid>
  </Border>
</UserControl>
