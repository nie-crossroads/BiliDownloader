<UserControl x:Class="BiliDownloader.Installer.Views.StepWelcome"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BiliDownloader.Installer.Views">
  <StackPanel>
    <StackPanel Margin="20,20,20,18">
      <TextBlock Text="准备安装" Style="{StaticResource Wt}"/>
      <TextBlock Text="选择安装位置，然后点「安装」。全程约 5 秒，不会修改系统设置。" Style="{StaticResource Wd}"/>

      <TextBlock Text="安装位置" Style="{StaticResource Lbl}"/>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Field}">
          <DockPanel LastChildFill="True">
            <Path DockPanel.Dock="Left" Width="14" Height="14" Stretch="Uniform"
                  Data="M1.8 4.6c0-.7.5-1.2 1.2-1.2h3l1.3 1.6h6.1c.7 0 1.2.5 1.2 1.2v6c0 .7-.5 1.2-1.2 1.2H3c-.7 0-1.2-.5-1.2-1.2z"
                  Stroke="{DynamicResource Fg3}" StrokeThickness="1.2" Fill="Transparent" Margin="0,0,8,0"/>
            <TextBlock Style="{StaticResource PathText}" Text="{Binding TargetDir}"/>
          </DockPanel>
        </Border>
        <Button Grid.Column="1" Style="{StaticResource BtnSm}" Content="浏览…"
                Command="{Binding BrowseCommand}" Margin="8,0,0,0"/>
      </Grid>
      <TextBlock Style="{StaticResource SubInfo}">
        <Run Text="{Binding RequireInfo, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding FreeSpaceText, Mode=OneWay}"/>
      </TextBlock>

      <StackPanel Margin="0,16,0,0">
        <CheckBox Style="{StaticResource ChkBox}" Content="创建桌面快捷方式" IsChecked="{Binding CreateShortcut}"/>
      </StackPanel>

      <Border Style="{StaticResource LicBox}">
        <DockPanel LastChildFill="True">
          <Canvas DockPanel.Dock="Left" Width="14" Height="14" Margin="0,1,9,0" VerticalAlignment="Top">
            <Ellipse Width="13" Height="13" Stroke="{DynamicResource Fg3}" StrokeThickness="1.2"/>
            <Path Data="M8 6.6 L8 10" Stroke="{DynamicResource Fg3}" StrokeThickness="1.3" StrokeEndLineCap="Round"/>
            <Ellipse Canvas.Left="7.2" Canvas.Top="3.5" Width="1.6" Height="1.6" Fill="{DynamicResource Fg3}"/>
          </Canvas>
          <TextBlock Style="{StaticResource LicText}">
            本程序内含 FFmpeg（LGPL v2.1 构建），许可全文与源码获取方式见安装目录
            <Run FontFamily="Consolas" Text="licenses\"/><Run Text="。"/><Hyperlink Click="OpenLicense">查看许可</Hyperlink>
          </TextBlock>
        </DockPanel>
      </Border>
    </StackPanel>

    <Border Style="{StaticResource FootBorder}">
      <DockPanel LastChildFill="False" VerticalAlignment="Center">
        <TextBlock DockPanel.Dock="Left" Style="{StaticResource FootLeft}" Text="安装包内嵌 FFmpeg 与卸载程序 · 离线安装"/>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Style="{StaticResource BtnGhost}" Content="取消" Command="{Binding CancelCommand}"/>
          <Button Style="{StaticResource BtnPrimary}" Content="安装" Command="{Binding InstallCommand}" Margin="10,0,0,0"/>
        </StackPanel>
      </DockPanel>
    </Border>
  </StackPanel>
</UserControl>
