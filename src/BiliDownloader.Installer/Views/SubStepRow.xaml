<UserControl x:Class="BiliDownloader.Installer.Views.SubStepRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="34">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <Grid Width="16" Height="16" VerticalAlignment="Center">
      <Border x:Name="Dot" Width="16" Height="16" CornerRadius="99" BorderThickness="1"
              BorderBrush="{DynamicResource Line2}" Background="{DynamicResource Surface3}"/>
      <Path x:Name="Check" Data="M4,8.4 L7,11.4 L12,5" Stroke="{DynamicResource OnAccent}"
            StrokeThickness="1.9" StrokeEndLineCap="Round" StrokeStartLineCap="Round" StrokeLineJoin="Round"
            Stretch="None" Width="16" Height="16" Visibility="Collapsed"/>
      <Ellipse x:Name="Pulse" Width="5" Height="5" Fill="{DynamicResource Accent}" Visibility="Collapsed">
        <Ellipse.Triggers>
          <EventTrigger RoutedEvent="Ellipse.Loaded">
            <BeginStoryboard>
              <Storyboard RepeatBehavior="Forever">
                <DoubleAnimation Storyboard.TargetName="Pulse" Storyboard.TargetProperty="Opacity"
                                From="1" To="0.2" Duration="0:0:0.8" AutoReverse="True"/>
              </Storyboard>
            </BeginStoryboard>
          </EventTrigger>
        </Ellipse.Triggers>
      </Ellipse>
    </Grid>

    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
      <TextBlock x:Name="TitleTb" Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                 FontSize="12" Foreground="{DynamicResource Fg3}"/>
      <TextBlock x:Name="StatusTb" Margin="8,0,0,0" FontSize="11" Foreground="{DynamicResource Fg3}" Text="等待"/>
    </StackPanel>
  </Grid>
</UserControl>
