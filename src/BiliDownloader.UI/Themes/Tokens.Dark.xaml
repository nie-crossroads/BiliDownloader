<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- 深色主题令牌（视觉规范 §3.1 / §3.2）。键名必须与 Tokens.Light.xaml 完全一致。 -->

    <SolidColorBrush x:Key="BgBrush" Color="#0C0E12" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#14171E" />
    <SolidColorBrush x:Key="Surface2Brush" Color="#1A1E28" />
    <SolidColorBrush x:Key="Surface3Brush" Color="#222733" />
    <SolidColorBrush x:Key="LineBrush" Color="#232936" />
    <SolidColorBrush x:Key="Line2Brush" Color="#333B4A" />
    <SolidColorBrush x:Key="FgBrush" Color="#EBEEF4" />
    <SolidColorBrush x:Key="Fg2Brush" Color="#9AA4B4" />
    <SolidColorBrush x:Key="Fg3Brush" Color="#7E8898" />
    <SolidColorBrush x:Key="FgOnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="HoverBrush" Color="#0DFFFFFF" />

    <SolidColorBrush x:Key="AccentBrush" Color="#FB7299" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF8CAD" />
    <SolidColorBrush x:Key="AccentPressBrush" Color="#E45D85" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#24FB7299" />
    <SolidColorBrush x:Key="AccentInkBrush" Color="#FF8CAD" />
    <SolidColorBrush x:Key="OkBrush" Color="#35D6A4" />
    <SolidColorBrush x:Key="WarnBrush" Color="#FFB454" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FF5F6D" />
    <SolidColorBrush x:Key="OkSoftBrush" Color="#2135D6A4" />
    <SolidColorBrush x:Key="WarnSoftBrush" Color="#21FFB454" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#21FF5F6D" />

    <LinearGradientBrush x:Key="ProgressGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#FB7299" />
        <GradientStop Offset="1" Color="#FF9FC0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CoverGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#3A2A44" />
        <GradientStop Offset="0.55" Color="#5B3550" />
        <GradientStop Offset="1" Color="#8A4A63" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AvatarGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#FF9E7A" />
        <GradientStop Offset="0.5" Color="#FB7299" />
        <GradientStop Offset="1" Color="#C86DD7" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="OverlayBrush" Color="#A606080B" />
    <SolidColorBrush x:Key="WindowEdgeBrush" Color="#0FFFFFFF" />

    <sys:Double x:Key="RadiusXs">4</sys:Double>
    <sys:Double x:Key="RadiusSm">6</sys:Double>
    <sys:Double x:Key="RadiusMd">10</sys:Double>
    <sys:Double x:Key="RadiusLg">14</sys:Double>
    <sys:Double x:Key="RadiusFull">99</sys:Double>
</ResourceDictionary>
