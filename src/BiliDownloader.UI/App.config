<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <runtime>
    <!--
      .NET Framework 的 WPF 默认「DPI 变化时不重新缩放」，等效于把窗口当位图拉伸，
      这就是 net48 应用在多屏 / 高缩放下文字发虚的原因。
      关掉这个开关后，配合 app.manifest 的 PerMonitorV2，WPF 才会在 DPI 变化时重排布局。
    -->
    <AppContextSwitchOverrides value="Switch.System.Windows.DoNotScaleForDpiChanges=false" />
  </runtime>

  <system.net>
    <settings>
      <servicePointManager expect100Continue="false" useNagleAlgorithm="false" />
    </settings>
    <!-- .NET Framework 的 ServicePoint 默认每个主机只允许 2 个并发连接，
         分片下载（默认 8 连接）会被硬卡在 2，不放开等于分片失效 -->
    <connectionManagement>
      <add address="*" maxconnection="64" />
    </connectionManagement>
  </system.net>
</configuration>
