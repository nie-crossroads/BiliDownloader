<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\BiliDownloader.Core\BiliDownloader.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <!-- net48 的 BCL 没有 System.Text.Json（Core 项目未把它传递过来，这里显式引用） -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\Polyfills.cs" Link="Polyfills\Polyfills.cs" />
    <!-- 真实窗口抓屏（PrintWindow 经 DWM 合成），用于验证 ClearType 与 DPI 缩放是否真的生效。
         与安装器共用同一份实现，避免两套截图口径不一致。 -->
    <Compile Include="..\SetupShared\WindowCapture.cs" Link="Diagnostics\WindowCapture.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- net48 里 System.Net.Http 是独立程序集；.NET Core 下它是框架的一部分，无需显式引用 -->
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\app.ico" />
    <Resource Include="Resources\app-icon.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- UseWindowsForms 会把这两个命名空间灌进全局 using，和 WPF 的 Application / Brush / Color 撞名
         （CS0104）。托盘只在 TrayIconService.cs 里用，那里显式 using 就够了，别污染整个项目。 -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 迁回 net48：运行时由 Win10 1903+ / Win11 系统自带，不再随安装包分发 166 MB 的 .NET 运行时 -->
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- 只为拿到 System.Windows.Forms.NotifyIcon（任务栏托盘）：WPF 没有自带托盘控件，
         纯 P/Invoke 手写要 150+ 行且菜单字体/DPI 细节难调。这里是框架内置开关，不加 NuGet 包。 -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- exe / 任务栏 / Alt-Tab / 安装包用多尺寸 ico；图标由 tools/IconForge 生成，勿手改 -->
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <!-- PerMonitorV2 DPI 感知声明；net48 下必须与 App.config 的 DoNotScaleForDpiChanges 开关配合 -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

</Project>
