{
  // BiliDownloader 应用图标 —— 「墨砖 + 白人字 + 粉托」
  // 唯一的几何事实源。改这里再跑 `IconForge render spec.json` 重新生成 ico。
  //
  // 纵向按「顶部留白 : 人字 : 纯砖分隔 : 粉托 : 底部留白」分配，人字一律取"窄而深"的箭头比例
  // （含圆头 宽/高 ≈ 1.1）。比例一扁就退化成人字形/蝙蝠形——这是 16px 唯一的死因。
  // 16 / 20 / 24 三档各自对齐自己的像素网格（不靠缩放），28 以上用母版。
  "sizes": [16, 20, 24, 28, 32, 40, 48, 64, 128, 256],
  "sizeMap": { "16": "tiny16", "20": "small20", "24": "small24" },
  "defaultVariant": "master",
  "outputIco": "../../src/BiliDownloader.UI/Resources/app.ico",
  "outputIconPng": "../../src/BiliDownloader.UI/Resources/app-icon.png",
  "outputPngDir": "png",
  "dumpAscii": [16, 20, 24],
  "variants": {

    // ── 母版 256：28 / 32 / 40 / 48 / 64 / 128 / 256 直接用（stroke 随缩放到 3.5/4/5/6/8/16/32）
    "master": {
      "viewBox": 256,
      "layers": [
        {
          "kind": "roundrect",
          "x": 16, "y": 16, "w": 224, "h": 224, "r": 48,
          "gradient": { "from": "#1E232D", "to": "#0C0E12", "angleDeg": 156 }
        },
        {
          "kind": "path",
          "d": "M128,66 V128 M88,100 L128,140 L168,100",
          "stroke": 32,
          "strokeFill": "#FFFFFF"
        },
        {
          // 托盘 128/224 = 57%，刻意比小尺寸（67~73%）窄：
          // 真正跨尺寸稳定的是"托盘 / 箭头" = 1.14~1.25，不是"托盘 / 砖"。
          // 小尺寸为了"贪大"把箭头放大了，托跟着放大才平衡；母版箭头不放大，托就不该加宽，
          // 否则 150 会让托盘/箭头 = 1.34，读成"进度条压着箭头"。
          "kind": "roundrect",
          "x": 64, "y": 176, "w": 128, "h": 32, "r": 16,
          "gradient": { "from": "#FF8CAD", "to": "#F0578A", "angleDeg": 151 }
        }
      ]
    },

    // ── 16px：托 100%。砖 1..15 / 竖杆 2.5..6.5 / 人字 4..9 / 粉托 11..13（宽 10）/ 底留 2
    // 人字含圆头跨度 8、高 7 → 宽高比 0.875（母版 1.03）。包围盒四边全落在整数上（x4→12、y3→10）。
    // 【2026-10-29 改】原来这一档去掉了竖杆，结果标题栏/托盘读作「人字」，任务栏 32px 读作「箭头」，
    // 两处对不上。现在统一带竖杆：杆只露出人字顶部之上的 1.5px 短桩（母版 15.2%，这里 1.5/14 = 10.7%），
    // 短到不会把凹口填平，但足够让 16px 也读成 ↓ 而不是 ˅。
    // 粉托宽 10 不是 12：12/14=86% 时左右只剩 1px 墨边，浅色任务栏上会被 AA 吃掉，且砖的底边像被刷成粉色。
    "tiny16": {
      "viewBox": 16,
      "layers": [
        { "kind": "roundrect", "x": 1, "y": 1, "w": 14, "h": 14, "r": 3, "fill": "#14171E" },
        { "kind": "path", "d": "M8,3 V7 M5,6 L8,9 L11,6", "stroke": 2, "strokeFill": "#FFFFFF" },
        { "kind": "roundrect", "x": 3, "y": 11, "w": 10, "h": 2, "r": 1, "fill": "#FB7299" }
      ]
    },

    // ── 20px：标题栏 brandmark 常驻尺寸。砖 1..19 / 竖杆 2.5..8 / 人字 4..12 / 分隔 13 / 托 14..17（宽 12）
    "small20": {
      "viewBox": 20,
      "layers": [
        { "kind": "roundrect", "x": 1, "y": 1, "w": 18, "h": 18, "r": 4, "fill": "#14171E" },
        { "kind": "path", "d": "M10,5 V10 M6,8 L10,12 L14,8", "stroke": 2, "strokeFill": "#FFFFFF" },
        { "kind": "roundrect", "x": 4, "y": 14, "w": 12, "h": 3, "r": 1.5, "fill": "#FB7299" }
      ]
    },

    // ── 24px：150% DPI 笔记本的托盘格子，单独槽位（16×1.5 会出半像素不对称）
    // 砖 1..23 / 竖杆 3..10 / 人字 5.25..13.5 / 托 17..20（宽 16）/ 底留 3。stroke 3
    "small24": {
      "viewBox": 24,
      "layers": [
        { "kind": "roundrect", "x": 1, "y": 1, "w": 22, "h": 22, "r": 5, "fill": "#14171E" },
        { "kind": "path", "d": "M12,5.5 V12 M7,8.5 L12,13.5 L17,8.5", "stroke": 3, "strokeFill": "#FFFFFF" },
        { "kind": "roundrect", "x": 4, "y": 17, "w": 16, "h": 3, "r": 1.5, "fill": "#FB7299" }
      ]
    }
  }
}
