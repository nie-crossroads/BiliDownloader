<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    本仓库所有 NuGet 还原（依赖包下载）统一落地到本地目录，不占用系统盘默认缓存。
    路径通过以下两项指定；同时已在用户级环境变量 NUGET_PACKAGES / NUGET_HTTP_CACHE_PATH
    中固化，二者指向同一位置，确保本项目及本机其他 .NET 项目的依赖都落在此目录。
  -->
  <config>
    <add key="globalPackagesFolder" value="E:\environment\NET\LocalStorage\nuget-packages" />
    <add key="http_cache_directory" value="E:\environment\NET\LocalStorage\nuget-http-cache" />
  </config>

  <!-- 仅允许官方源，避免供应链风险；如需私有源在此追加 <add key="..." /> -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
